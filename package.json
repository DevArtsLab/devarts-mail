{
  "name": "devarts-mail",
  "version": "1.0.0",
  "private": true,
  "description": "DevArts Lab mail + calendar on Cloudflare Workers: inbound email, outbound sending, calendar invites (RSVP), independent calendar.",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "setup": "node scripts/setup.mjs",
    "migrate:local": "wrangler d1 migrations apply devarts-mail --local",
    "migrate:remote": "wrangler d1 migrations apply devarts-mail --remote",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "mimetext": "^3.0.28",
    "postal-mime": "^4.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
